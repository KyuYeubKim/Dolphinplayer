<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube 영상 카드: 16:9 썸네일(길이 표시) + 제목 두 줄 + 채널 · 조회수 · 올린 때 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.dolphin.mplayer.VideoThumbView
            android:id="@+id/cardThumb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cover"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/cardBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="#CC000000"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/cardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/cardSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />
</LinearLayout>
