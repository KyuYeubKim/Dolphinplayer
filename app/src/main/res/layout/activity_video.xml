<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <SurfaceView
        android:id="@+id/videoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- YouTube 영상을 받는 동안 (0.66) -->
    <ProgressBar
        android:id="@+id/videoLoading"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 화면을 누르면 나오는 조작 버튼 -->
    <FrameLayout
        android:id="@+id/videoControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#99000000"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/videoBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/close"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/videoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:paddingStart="8dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#99000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/videoBack10"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_round_button"
                android:gravity="center"
                android:text="-10s"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/videoPlay"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_play"
                android:contentDescription="@string/cd_play"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="#000000" />

            <TextView
                android:id="@+id/videoFwd10"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_round_button"
                android:gravity="center"
                android:text="+10s"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/videoSeek"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:progressBackgroundTint="@color/surface2"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/videoTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
